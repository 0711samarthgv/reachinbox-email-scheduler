generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id               String             @id @default(uuid())
  googleId         String?            @unique
  name             String
  email            String             @unique
  avatarUrl        String?
  passwordHash     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  emailAccounts    EmailAccount[]
  campaigns        Campaign[]
  slackConnections SlackConnection[]
}

model EmailAccount {
  id          String    @id @default(uuid())
  userId      String
  email       String
  displayName String?
  provider    String    @default("ethereal")
  smtpUser    String?
  smtpPass    String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]
  emails      Email[]
  @@unique([userId, email])
  @@index([userId])
}

model Campaign {
  id            String        @id @default(uuid())
  userId        String
  senderId      String
  subject       String
  body          String
  startTime     DateTime
  delayMs       Int
  hourlyLimit   Int
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender        EmailAccount  @relation(fields: [senderId], references: [id])
  emails        Email[]
  @@index([userId, createdAt])
}

model Email {
  id              String      @id @default(uuid())
  campaignId      String
  userId          String
  senderId        String
  recipient       String
  subject         String
  body            String
  scheduledAt     DateTime
  sentAt          DateTime?
  status          EmailStatus @default(SCHEDULED)
  bullJobId       String?     @unique
  idempotencyKey  String      @unique
  attempts        Int         @default(0)
  errorMessage    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  campaign        Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender          EmailAccount @relation(fields: [senderId], references: [id])
  @@index([userId, status, scheduledAt])
  @@index([senderId, scheduledAt])
  @@index([recipient])
}

model SlackConnection {
  id           String   @id @default(uuid())
  userId       String
  teamId       String
  teamName     String?
  accessToken  String
  slackUserId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, teamId])
}
